# The sender's settings. Copy to .env (never commit it), or set these where you run it.

# The same long random text as LINKED_SENDER_SECRET on the website (openssl rand -hex 32). At least 24 characters.
SENDER_SECRET=

# The website's address
APP_URL=https://unitedtribes.example

# Where to listen. Put HTTPS in front of it (a Cloudflare Tunnel, Caddy or your host's own HTTPS): the sign-in code travels in the request.
PORT=8080

# Where the WhatsApp login is kept. Keep this folder safe and backed up. Losing it means linking the number again.
AUTH_DIR=./auth
