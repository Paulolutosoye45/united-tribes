# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project settings > API) ---------------------------------------
# The URL and the publishable key are safe to expose to the browser: access is
# controlled by the database rules, not by hiding these.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Links we hand out (referee links) ----------------------------------------
# The public address of the site, with no trailing slash. When unset, links are
# built from the request, which is fine for local work. Set it in production.
# NEXT_PUBLIC_SITE_URL=https://unitedtribes.example.org

# --- Style guide page (/design) ----------------------------------------------
# Open in development. In production it returns 404 unless this is "true" at
# build time. Turn it on for a staging site only.
# ENABLE_STYLE_PAGE=true

# --- Assistant (suggestions in the form; also used by the comparison script) -----
# AI_PROVIDER=anthropic | openai | mock | none
#   Unset: uses whichever key below is present. "none" turns the assistant off,
#   and the form simply shows plain options.
# AI_PROVIDER=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# These keys are server-side only. Never prefix them with NEXT_PUBLIC_.

# --- Sign in with a code on WhatsApp (Phase 7) --------------------------------
# Off until the sign-in service can send a code. Turn on ("on") only after one
# of the two set-ups in the README is finished, so nobody sees a dead button.
# WHATSAPP_SIGNIN=on
#
# Set-up B only: Supabase calls /api/auth/send-code (its "Send SMS" hook) and
# this app sends the code through the WhatsApp Business Cloud API. Server-side
# only; never prefix with NEXT_PUBLIC_. With set-up A (Twilio inside Supabase)
# none of the lines below are needed.
# SEND_SMS_HOOK_SECRET=v1,whsec_...        # shown once, when you create the hook
# WHATSAPP_PROVIDER=meta                   # meta | none
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=                   # a system-user token, not a personal one
# WHATSAPP_TEMPLATE_NAME=                  # your approved "authentication" template
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_GRAPH_VERSION=v23.0
