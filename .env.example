# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project settings > API) ---------------------------------------
# The URL and the publishable key are safe to expose to the browser: access is
# controlled by the database rules, not by hiding these.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Older projects call the same key the "anon" key; it is accepted if the line above is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Links we hand out (referee links) ----------------------------------------
# The public address of the site, with no trailing slash. When unset, links are
# built from the request, which is fine for local work. Set it in production.
# NEXT_PUBLIC_SITE_URL=https://unitedtribes.example.org
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is set for you and is used when the line above is unset.

# --- Style guide page (/design) ----------------------------------------------
# Open in development. In production it returns 404 unless this is "true" at
# build time. Turn it on for a staging site only.
# ENABLE_STYLE_PAGE=true

# --- Assistant (suggestions in the form; also used by the comparison script) -----
# AI_PROVIDER=anthropic | openai | mock | none
#   Unset: uses whichever key below is present. "none" turns the assistant off,
#   and the form simply shows plain options.
# AI_PROVIDER=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# These keys are server-side only. Never prefix them with NEXT_PUBLIC_.

# --- Voice notes (the 60-second "tell us about your season" recording) ---------
# The recording is held in memory while it is turned into words and is never stored.
# STT_PROVIDER=openai | mock | none
#   Unset: uses OpenAI if OPENAI_API_KEY is set, otherwise voice notes are off and the
#   form falls back to the phone's own dictation, or typing.
# STT_PROVIDER=
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe   # whisper-1 also works. Choose after the real-voice bake-off.
# STT_MOCK_TEXT=                            # mock only: the words it "hears"
# OPENAI_API_BASE=                          # tests and stand-ins only

# --- Sealing private notes (REQUIRED in production) -----------------------------
# What a member writes about needing extra care, and the note to their leader, are sealed
# (AES-256-GCM) before they reach the database, so a database backup or a stray query never
# shows them. Format: "id:base64key", where the key is 32 random bytes. The FIRST key seals;
# every key listed can still open, so you can rotate by putting a new one first and keeping the old.
#   Make one:   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
#   Several:    DATA_ENCRYPTION_KEYS=k2:...,k1:...
# Lose every key and the sealed notes cannot be read again. Keep a copy somewhere safe.
# Without it, production refuses to save these notes (the rest of the form still works).
# DATA_ENCRYPTION_KEYS=

# --- Sign in with a code on WhatsApp (Phase 7) --------------------------------
# Off until the sign-in service can send a code. Turn on ("on") only after one
# of the two set-ups in the README is finished, so nobody sees a dead button.
# WHATSAPP_SIGNIN=on
#
# Set-up B only: Supabase calls /api/auth/send-code (its "Send SMS" hook) and
# this app sends the code through the WhatsApp Business Cloud API. Server-side
# only; never prefix with NEXT_PUBLIC_. With set-up A (Twilio inside Supabase)
# none of the lines below are needed.
# SEND_SMS_HOOK_SECRET=v1,whsec_...        # shown once, when you create the hook
# WHATSAPP_PROVIDER=meta                   # meta | none
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=                   # a system-user token, not a personal one
# WHATSAPP_TEMPLATE_NAME=                  # your approved "authentication" template
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_GRAPH_VERSION=v23.0
#
# Phase 6: which road a WhatsApp sign-in code takes. Default "official" (the Meta lines above). "linked" sends it from an
# ordinary WhatsApp number run by the small always-on service in /sender (read sender/README.md and
# docs/SIGNIN-CHANNELS.md first: it is optional, and it carries a risk of the number being restricted).
# SIGNIN_WHATSAPP_ROUTE=official           # official | linked
# LINKED_SENDER_URL=https://sender.example # the service's https address (linked only)
# LINKED_SENDER_SECRET=                    # openssl rand -hex 32; the same text as SENDER_SECRET there. At least 24 characters
# WHATSAPP_SIGNIN_NUMBER=2348031234567     # the number people message and are told to save (digits only, with country code). Shown on the sign-in screen
# SIGNIN_HASH_SALT=                        # openssl rand -hex 32. Optional: without it a salt is derived from WORKER_TOKEN.
#                                          # Numbers and networks are only ever stored as salted hashes; changing this forgets the recent past

# --- Testimonies -----------------------------------------------------------------
# Where the pastorate sends a testimony the church wants to keep: the address of TCN's own
# testimony form. Optional; without it the page still shows the words to copy.
# TESTIMONY_FORM_URL=https://thecovenantnation.org/testimony

# --- Messages: WhatsApp, email and text (Stage 2) ------------------------------
# The sending service is a heartbeat (/api/cron/tick) that runs the season calendar and
# sends what is due. Everything below is server-side only; never prefix with NEXT_PUBLIC_.
#
# 1. A worker token: a random secret that opens only the few database functions the
#    sender needs. Make one in the SQL editor ONCE:  select public.bootstrap_worker_token('sender');
#    (after that, admins can make and revoke tokens on the settings page). Put it here:
# WORKER_TOKEN=utw_...
#
# 2. Who may call the heartbeat. Vercel Cron sends CRON_SECRET by itself; any other
#    scheduler can send the same value, or the worker token, as "Authorization: Bearer ...".
# CRON_SECRET=
#
# 3. Providers. Nothing is sent until a channel has one. To try everything first with no
#    accounts at all, set MESSAGING_MODE=log: messages are written to the server log instead.
# MESSAGING_MODE=log
#
#   WhatsApp (templates must be approved first: npm run templates -- --submit)
#   Uses the same WHATSAPP_PROVIDER / WHATSAPP_PHONE_NUMBER_ID / WHATSAPP_ACCESS_TOKEN as sign-in.
# WHATSAPP_BUSINESS_ACCOUNT_ID=             # only for `npm run templates`
# WHATSAPP_TEMPLATE_SUFFIX=                 # leave empty. Set to e.g. _v2 only after a reworded set is approved (see UPGRADE-TRIBES.md)
# WHATSAPP_APP_SECRET=                      # Meta app secret: checks that webhook calls are really Meta's
# WHATSAPP_VERIFY_TOKEN=                    # any long random text; paste the same into Meta's webhook page
#   Webhook address to give Meta:  https://YOUR-SITE/api/webhooks/whatsapp  (subscribe to "messages")
#
#   Email through Resend (verify your sending domain there first)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="United Tribes <hello@your-domain.org>"
# EMAIL_REPLY_TO=pastoral@your-domain.org
# EMAIL_WEBHOOK_SECRET=whsec_...            # from Resend's webhook page; address: https://YOUR-SITE/api/webhooks/email
#
#   Email through your own mail server (SMTP) instead of Resend. Full steps: docs/EMAIL-SMTP.md
# EMAIL_PROVIDER=smtp
# SMTP_HOST=mail.your-domain.org            # must be the name on the server's TLS certificate
# SMTP_PORT=587                             # 587 (starts plain, then upgrades) or 465 (encrypted from the start)
# SMTP_SECURITY=starttls                    # starttls | tls | none (none only for a server on the same machine). Port 465 means tls unless set.
# SMTP_USER=hello@your-domain.org
# SMTP_PASSWORD=
# EMAIL_FROM="United Tribes <hello@your-domain.org>"   # a domain your server signs (DKIM) and lists (SPF)
# EMAIL_REPLY_TO=pastoral@your-domain.org
# SMTP_BOUNCE_ADDRESS=bounces@your-domain.org           # optional: where undeliverable-mail notices go (defaults to EMAIL_FROM's address)
# SMTP_HELO_NAME=mail.your-domain.org                   # optional: the name to greet the server with
#
#   Text messages: Termii (strong Nigerian routes) or Twilio
# SMS_PROVIDER=termii
# TERMII_API_KEY=
# TERMII_SENDER_ID=                         # approved sender name, up to 11 characters
# TERMII_ROUTE=dnd                          # dnd reaches numbers on the Do-Not-Disturb list; generic does not
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...                         # or TWILIO_MESSAGING_SERVICE_SID=MG...
#
# Addresses used in tests and local stand-ins only (leave unset in production):
# WHATSAPP_API_BASE=   RESEND_API_BASE=   TERMII_BASE_URL=   TWILIO_API_BASE=

# --- Bot check on sign-in and on links anyone can open (Stage 8) -----------------------------
# Cloudflare Turnstile (free). Without these lines nothing changes and no account is needed.
# To switch it on:
#   1. Cloudflare dashboard > Turnstile > Add widget; allow your site's domain; copy the two keys.
#   2. NEXT_PUBLIC_TURNSTILE_SITE_KEY is public and is written into the site when it is BUILT: set it, then redeploy.
#   3. TURNSTILE_SECRET_KEY is server-side only. It checks the answer to a parent's "yes" and a referee's reference.
#   4. In Supabase > Authentication > Attack Protection, turn on CAPTCHA protection, choose Turnstile and paste the
#      same secret key. Sign-in then refuses a request that has no valid token. (Skip this and sign-in is not checked.)
# Taking permission back, or declining, on the parent's page is never held up by the check.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Addresses used in tests and local stand-ins only (leave unset in production):
# NEXT_PUBLIC_TURNSTILE_SCRIPT_URL=   TURNSTILE_VERIFY_URL=

# --- Security policy (Stage 8) -----------------------------------------------------------------
# Every page is sent with a strict Content-Security-Policy. If a new service is ever added and something stops working,
# set this to "true" for a day: the browser then only REPORTS what the policy would have blocked (see the browser's
# console) instead of blocking it, so you can see what to allow. Turn it off again afterwards.
# CSP_REPORT_ONLY=true
